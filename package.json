{
  "name": "sentinel",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w @sentinel/backend\" \"npm run dev -w @sentinel/frontend\"",
    "build": "npm run build --workspaces",
    "dev:frontend": "npm run dev -w @sentinel/frontend",
    "dev:backend": "npm run dev -w @sentinel/backend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "@vercel/node": "^5.10.1",
    "concurrently": "^9.1.2"
  }
}
