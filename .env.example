# ============================================================
# Variáveis de ambiente — Postgres puro + login próprio (Coolify)
# ============================================================
# No Coolify: aba Environment Variables do app.
# Para rodar na sua máquina: copie este arquivo para .env.local e preencha.
# O .env.local está no .gitignore e nunca vai para o GitHub.

# Conexão do Postgres (o banco do Coolify). Formato:
# postgresql://usuario:senha@host:5432/nome_do_banco
# Dentro do Coolify use o host interno do serviço de banco.
DATABASE_URL=

# Assina os tokens de login (JWT). Gere um valor aleatório com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECRETO: quem o tem forja sessões. Trocá-lo desloga todo mundo.
JWT_SECRET=

# Quem administra o painel (cria usuários e troca senhas em Configurações).
# Vários: separe por vírgula.
ADMIN_EMAILS=seuemail@gmail.com

# ------------------------------------------------------------
# Opcionais
# ------------------------------------------------------------
# Cifra os tokens salvos (Meta CAPI). Sem ela, deriva do JWT_SECRET —
# mas aí trocar o JWT_SECRET deixa os tokens ilegíveis. Defina desde o
# início se quiser poder girar o JWT_SECRET sem recolar tokens.
# ENCRYPTION_KEY=

# Protege o GET /api/capi/retry-cron para disparo externo. O reenvio diário
# já roda sozinho dentro do servidor; só precisa disto se um cron de fora
# for chamar a rota.
# CRON_SECRET=

# Porta do servidor (padrão 3001).
# PORT=3001
